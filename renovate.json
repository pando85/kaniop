{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Keep Kanidm crate requirements current",
      "matchManagers": ["cargo"],
      "matchPackageNames": [
        "kanidm_client",
        "kanidm_lib_crypto",
        "kanidm_proto"
      ],
      "rangeStrategy": "bump"
    }
  ]
}
